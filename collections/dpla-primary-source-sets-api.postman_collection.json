  "info": {
    "_postman_id": "4a321a34-14b3-4d60-885d-e76c8d28b067",
    "name": "Digital Public Library of America (DPLA) Authentication Primary Source Sets API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Digital Public Library of America (DPLA) provides a free REST API that gives access to metadata for 50 million+ cultural heritage items aggregated from 4,000+ US libraries, archives, and museums. The API supports full-text search, field-specific queries, geographic and date range filtering, faceted browsing, and JSONP callbacks. All results are returned as JSON-LD. API keys are issued free of charge via a self-service email-based registration endpoint.\n\nContact Support:\n Name: DPLA Developer Portal",
      "type": "text/plain"
    }
  }
